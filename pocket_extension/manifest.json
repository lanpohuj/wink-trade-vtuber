{
  "manifest_version": 3,
  "name": "Winky Neural Vision HUD — Pocket Option",
  "version": "2.1.0",
  "description": "Tactical In-DOM Neural Vision HUD, 3-Vector Matrix analysis, chart laser scan, and live score counter for Pocket Option.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "content.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Winky Neural Vision HUD"
  }
}
