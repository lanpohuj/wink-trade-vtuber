{
  "manifest_version": 3,
  "name": "Winky AI — Pocket Option Trading Bot",
  "version": "2.3.3",
  "description": "Pocket Option trading HUD with contextual recorded Winky commentary and Fish Audio chat replies.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://winktrade-app.online/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "page_hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "content.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Winky AI Trading Bot"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "page_hook.js"
      ],
      "matches": [
        "*://po.financial/*",
        "*://pocketoption.com/*",
        "*://po.market/*",
        "*://po4.cash/*",
        "*://po2.cash/*",
        "*://*.pocketoption.com/*",
        "<all_urls>"
      ]
    }
  ]
}
