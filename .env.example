# ==========================================================
# Wink Trade — пример конфигурации окружения (.env.example)
# Скопируйте этот файл в .env и заполните своими значениями:
#   cp .env.example .env
# ==========================================================

# --- Telegram Bot ---
# Токен бота, полученный у @BotFather
BOT_TOKEN=123456789:AAE4XaPfjK2w3y5U8rB0vN7mQ1zL9cD6eFg
# Публичный HTTPS-URL, по которому FastAPI раздаёт Mini App (маршрут /webapp)
WEBAPP_URL=https://2.31.127.199.sslip.io/webapp/
# Username службы поддержки в Telegram (без @)
SUPPORT_USERNAME=winktrade_support

# --- Партнёрская программа Pocket Partners (кампания 988258) ---
# Прямые ссылки на форму быстрой регистрации (REGISTER со встроенным промокодом code=50START)
RU_PARTNER_BASE_URL="https://po-ru4.click/register?utm_campaign=871226&utm_source=affiliate&utm_medium=sr&a=ng70XXOKb9ECCk&al=1808145&ac=wink&cid=988258&code=50START"
EN_PARTNER_BASE_URL="https://u3.shortink.io/register?utm_campaign=871226&utm_source=affiliate&utm_medium=sr&a=ng70XXOKb9ECCk&al=1808145&ac=wink&cid=988258&code=50START"
ONELINK_URL=https://poaffiliate.onelink.me/t5P7/5m3y6xfj
PARTNER_BASE_URL=
CAMPAIGN_ID=wink

# Рабочие зеркала кассы для кнопки «Пополнить баланс» (+50% с кодом 50START)
RU_DEPOSIT_URL="https://po-ru4.click/cabinet/deposit?utm_campaign=871226&utm_source=affiliate&utm_medium=sr&a=ng70XXOKb9ECCk&al=1808145&ac=wink&cid=988258&code=50START"
EN_DEPOSIT_URL="https://u3.shortink.io/cabinet/deposit?utm_campaign=871226&utm_source=affiliate&utm_medium=sr&a=ng70XXOKb9ECCk&al=1808145&ac=wink&cid=988258&code=50START"
PLATFORM_URL="https://po-ru4.click/register?utm_campaign=871226&utm_source=affiliate&utm_medium=sr&a=ng70XXOKb9ECCk&al=1808145&ac=wink&cid=988258&code=50START"

# Промокод партнёрки (+50% бонус при пополнении от $50)
PROMO_CODE=50START
PROMO_BONUS_PERCENT=50
PROMO_MIN_DEPOSIT_USD=50
MIN_DEPOSIT_USD=10

# --- Postback API ---
# Секрет приёма постбеков от Pocket Partners. Указывается в URL постбека
# на стороне партнёрки (.../api/postback?token=СЕКРЕТ&...) или в заголовке
# X-Postback-Token. Если не задан — постбеки отклоняются (403).
POSTBACK_SECRET=change-me-super-secret

# --- Админы / стримеры ---
# Telegram ID через запятую — им доступен стримерский режим демонстрации сигналов
ADMIN_TG_IDS=111111111,222222222

# --- База данных ---
# DSN подключения к SQLite (локально или через Docker volume /data)
DATABASE_URL=sqlite+aiosqlite:///./wink_trade.db
DATABASE_ECHO=false

# --- Бизнес-логика воронки и сигналов ---
DEFAULT_LANG=ru
# Сумма минимального депозита, о которой сообщается пользователю (USD)
MIN_DEPOSIT_USD=10
# Границы точности сигналов в UI, %
SIGNAL_ACCURACY_MIN=81
SIGNAL_ACCURACY_MAX=93
# Показывать счётчик «всего N трейдеров» начиная с этого числа
TOTAL_COUNTER_THRESHOLD=100

# --- Ежедневный тизер ---
# Час отправки тизера (локальное время сервера) и максимум сообщений одному пользователю
TEASER_HOUR=19
TEASER_MAX_COUNT=7

# --- VTuber-агент Winky (запуск: python -m winky.app) ---
# Lumean TTS (https://lumean.app) — озвучка Fish Audio / ElevenLabs / Cartesia
LUMEAN_API_KEY=
# Русский голос (RU Voice)
LUMEAN_RU_SERVICE=fishaudio
LUMEAN_RU_VOICE_ID=1db1618b6eaf4571ac7db70e20eb6727
LUMEAN_RU_VOICE_NAME="Марин китагава"
# Английский голос (EN Voice)
LUMEAN_EN_SERVICE=fishaudio
LUMEAN_EN_VOICE_ID=e34c486929524d41b88646b4ac2f382f
LUMEAN_EN_VOICE_NAME="Venti"
# Общие параметры (fallback)
LUMEAN_SERVICE=fishaudio
LUMEAN_VOICE_ID=1db1618b6eaf4571ac7db70e20eb6727
LUMEAN_VOICE_NAME="Марин китагава"
LUMEAN_TEMPLATE_ID=

# ElevenLabs TTS (напрямую, опционально)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Запрещённые темы реплик через запятую (цензура Winky)
WINKY_BANNED_TOPICS=

# --- TikTok-чат + DeepSeek / River AI ---
# Юзернейм TikTok-аккаунта, с которого идёт стрим (без @). Пусто — выключен.
TIKTOK_USERNAME=
# API-ключ River AI (console.river.ai) для модели DeepSeek-V4.1-Flash
RIVER_API_KEY=
# Ключ DeepSeek (https://platform.deepseek.com). Пусто — Winky отвечает сценарными фоллбэками.
DEEPSEEK_API_KEY=
# Base URL для OpenAI-совместимого API (например https://api.river.ai/v1 или https://api.deepseek.com)
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
# Лимиты анти-спама: пауза между LLM-ответами и между приветствиями зрителей (в секундах)
WINKY_LLM_MIN_INTERVAL=8.0
WINKY_GREET_MIN_INTERVAL=90.0

# --- HTTP-сервер (FastAPI + Uvicorn) ---
API_HOST=0.0.0.0
API_PORT=8000
